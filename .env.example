# =====================================================================
# GR-IA - Variables de entorno
#
# Copiar este fichero a .env y ajustar valores si fuera necesario:
#     cp .env.example .env
#
# Todos los valores por defecto coinciden con docker-compose.yml
# y con src/config.py, por lo que el sistema funciona sin modificar
# este fichero en una instalacion local estandar.
# =====================================================================

# --- PostgreSQL -----------------------------------------------------
# Estos valores deben coincidir con los definidos en docker-compose.yml
GRIA_DB_HOST=localhost
GRIA_DB_PORT=5432
GRIA_DB_NAME=gria_db
GRIA_DB_USER=admin
GRIA_DB_PASSWORD=adminpassword

# --- Ollama ---------------------------------------------------------
# Endpoint del servidor Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Modelos requeridos (descargar con `ollama pull <modelo>`)
OLLAMA_VISION_MODEL=minicpm-v
OLLAMA_TEXT_MODEL=qwen2.5:1.5b
OLLAMA_GENERATION_MODEL=qwen2.5:1.5b
