# Python
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Data (too large for git)
src/data/*.csv
src/data/*.parquet
src/data/etl_progress.json
src/data/sr_legacy/

# Local model cache (downloaded automatically at runtime)
models/

# Evaluacion: imagenes (licencia/tamano) y reportes generados.
# Se versionan los .jsonl de ground truth y la estructura de carpetas.
evaluation/images/*
!evaluation/images/.gitkeep
evaluation/reports/*
!evaluation/reports/.gitkeep

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store

# Environment (credenciales locales - usar .env.example como plantilla)
.env
.env.local
